<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="TabulateAI.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:TabulateAI.Views"
    Title="Expensely"
    Shell.FlyoutBehavior="Disabled"
    Shell.NavBarIsVisible="False">

    <TabBar>
        <ShellContent
            Title="Home"
            Icon="icon_home.svg"
            ContentTemplate="{DataTemplate views:DashboardPage}"
            Route="DashboardPage" />

        <ShellContent
            Title="History"
            Icon="icon_history.svg"
            ContentTemplate="{DataTemplate views:HistoryPage}"
            Route="HistoryPage" />

        <ShellContent
            Title=""
            Icon="icon_camera_fab.svg"
            ContentTemplate="{DataTemplate views:ScanPage}"
            Route="ScanPage" />

        <ShellContent
            Title="Reports"
            Icon="icon_reports.svg"
            ContentTemplate="{DataTemplate views:ReportsPage}"
            Route="ReportsPage" />

        <ShellContent
            Title="Settings"
            Icon="icon_settings.svg"
            ContentTemplate="{DataTemplate views:SettingsPage}"
            Route="SettingsPage" />
    </TabBar>

</Shell>
