<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:TabulateAI.ViewModels"
             xmlns:models="clr-namespace:TabulateAI.Models"
             x:Class="TabulateAI.Views.ReportsPage"
             x:DataType="vm:ReportsViewModel"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{DynamicResource Surface}">

    <Grid RowDefinitions="Auto,*">

        <!-- Row 0: Header -->
        <Grid Grid.Row="0"
              BackgroundColor="{DynamicResource CardWhite}"
              Padding="16,14,16,12"
              RowDefinitions="Auto,Auto">
            <VerticalStackLayout Grid.Row="0"
                                 Spacing="0">
                <Label Text="Reports"
                       FontFamily="OpenSansBold"
                       FontSize="17"
                       FontAttributes="Bold"
                       TextColor="{DynamicResource T1}" />
                <Label Text="Analyse &amp; export spending"
                       FontFamily="OpenSansRegular"
                       FontSize="11"
                       TextColor="{DynamicResource T2}"
                       Margin="0,2,0,0" />
            </VerticalStackLayout>
            <BoxView Grid.Row="1"
                     HeightRequest="0.5"
                     Color="{DynamicResource Border}"
                     Margin="0,12,0,0" />
        </Grid>

        <!-- Row 1: ScrollView -->
        <ScrollView Grid.Row="1">
            <VerticalStackLayout Spacing="0">

                <!-- Period selector -->
                <Grid Padding="14,10,14,0"
                      ColumnDefinitions="*,*"
                      RowDefinitions="Auto,Auto"
                      ColumnSpacing="6"
                      RowSpacing="6">
                    <Border Grid.Row="0" Grid.Column="0"
                            StrokeShape="RoundRectangle 10"
                            Padding="0,7"
                            BackgroundColor="{Binding SelectedPeriod, Converter={StaticResource StringEqualsToColorConverter}, ConverterParameter=This month}"
                            Stroke="{DynamicResource Border}"
                            StrokeThickness="0.5">
                        <Border.Triggers>
                            <DataTrigger TargetType="Border"
                                         Binding="{Binding SelectedPeriod, Converter={StaticResource StringEqualsConverter}, ConverterParameter=This month}"
                                         Value="True">
                                <Setter Property="Stroke" Value="Transparent" />
                                <Setter Property="StrokeThickness" Value="0" />
                            </DataTrigger>
                        </Border.Triggers>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding SelectPeriodCommand}"
                                                  CommandParameter="This month" />
                        </Border.GestureRecognizers>
                        <Label Text="This month"
                               FontFamily="OpenSansBold"
                               FontSize="10"
                               FontAttributes="Bold"
                               HorizontalOptions="Center"
                               TextColor="{Binding SelectedPeriod, Converter={StaticResource StringEqualsToTextColorConverter}, ConverterParameter=This month}" />
                    </Border>
                    <Border Grid.Row="0" Grid.Column="1"
                            StrokeShape="RoundRectangle 10"
                            Padding="0,7"
                            BackgroundColor="{Binding SelectedPeriod, Converter={StaticResource StringEqualsToColorConverter}, ConverterParameter=Last month}"
                            Stroke="{DynamicResource Border}"
                            StrokeThickness="0.5">
                        <Border.Triggers>
                            <DataTrigger TargetType="Border"
                                         Binding="{Binding SelectedPeriod, Converter={StaticResource StringEqualsConverter}, ConverterParameter=Last month}"
                                         Value="True">
                                <Setter Property="Stroke" Value="Transparent" />
                                <Setter Property="StrokeThickness" Value="0" />
                            </DataTrigger>
                        </Border.Triggers>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding SelectPeriodCommand}"
                                                  CommandParameter="Last month" />
                        </Border.GestureRecognizers>
                        <Label Text="Last month"
                               FontFamily="OpenSansBold"
                               FontSize="10"
                               FontAttributes="Bold"
                               HorizontalOptions="Center"
                               TextColor="{Binding SelectedPeriod, Converter={StaticResource StringEqualsToTextColorConverter}, ConverterParameter=Last month}" />
                    </Border>
                    <Border Grid.Row="1" Grid.Column="0"
                            StrokeShape="RoundRectangle 10"
                            Padding="0,7"
                            BackgroundColor="{Binding SelectedPeriod, Converter={StaticResource StringEqualsToColorConverter}, ConverterParameter=This year}"
                            Stroke="{DynamicResource Border}"
                            StrokeThickness="0.5">
                        <Border.Triggers>
                            <DataTrigger TargetType="Border"
                                         Binding="{Binding SelectedPeriod, Converter={StaticResource StringEqualsConverter}, ConverterParameter=This year}"
                                         Value="True">
                                <Setter Property="Stroke" Value="Transparent" />
                                <Setter Property="StrokeThickness" Value="0" />
                            </DataTrigger>
                        </Border.Triggers>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding SelectPeriodCommand}"
                                                  CommandParameter="This year" />
                        </Border.GestureRecognizers>
                        <Label Text="This year"
                               FontFamily="OpenSansBold"
                               FontSize="10"
                               FontAttributes="Bold"
                               HorizontalOptions="Center"
                               TextColor="{Binding SelectedPeriod, Converter={StaticResource StringEqualsToTextColorConverter}, ConverterParameter=This year}" />
                    </Border>
                    <Border Grid.Row="1" Grid.Column="1"
                            StrokeShape="RoundRectangle 10"
                            Padding="0,7"
                            BackgroundColor="{Binding SelectedPeriod, Converter={StaticResource StringEqualsToColorConverter}, ConverterParameter=Custom}"
                            Stroke="{DynamicResource Border}"
                            StrokeThickness="0.5">
                        <Border.Triggers>
                            <DataTrigger TargetType="Border"
                                         Binding="{Binding SelectedPeriod, Converter={StaticResource StringEqualsConverter}, ConverterParameter=Custom}"
                                         Value="True">
                                <Setter Property="Stroke" Value="Transparent" />
                                <Setter Property="StrokeThickness" Value="0" />
                            </DataTrigger>
                        </Border.Triggers>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding SelectPeriodCommand}"
                                                  CommandParameter="Custom" />
                        </Border.GestureRecognizers>
                        <Label Text="Custom"
                               FontFamily="OpenSansBold"
                               FontSize="10"
                               FontAttributes="Bold"
                               HorizontalOptions="Center"
                               TextColor="{Binding SelectedPeriod, Converter={StaticResource StringEqualsToTextColorConverter}, ConverterParameter=Custom}" />
                    </Border>
                </Grid>

                <!-- Custom date range -->
                <Border BackgroundColor="{DynamicResource CardWhite}"
                        Margin="14,8,14,0"
                        Stroke="{DynamicResource Border}"
                        StrokeThickness="0.5"
                        StrokeShape="RoundRectangle 12"
                        Padding="14"
                        IsVisible="{Binding IsCustomPeriod}">
                    <VerticalStackLayout Spacing="10">
                        <Label Text="Custom date range"
                               FontFamily="OpenSansBold"
                               FontSize="12"
                               FontAttributes="Bold"
                               TextColor="{DynamicResource T1}" />
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                            <Label Text="From"
                                   FontFamily="OpenSansRegular"
                                   FontSize="12"
                                   TextColor="{DynamicResource T2}"
                                   VerticalOptions="Center" />
                            <DatePicker Grid.Column="1"
                                        Date="{Binding CustomStartDate}"
                                        FontFamily="OpenSansRegular"
                                        TextColor="{DynamicResource T1}" />
                        </Grid>
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                            <Label Text="To"
                                   FontFamily="OpenSansRegular"
                                   FontSize="12"
                                   TextColor="{DynamicResource T2}"
                                   VerticalOptions="Center" />
                            <DatePicker Grid.Column="1"
                                        Date="{Binding CustomEndDate}"
                                        FontFamily="OpenSansRegular"
                                        TextColor="{DynamicResource T1}" />
                        </Grid>
                        <Border BackgroundColor="{StaticResource Violet}"
                                StrokeShape="RoundRectangle 10"
                                Stroke="Transparent"
                                HeightRequest="40">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding ApplyCustomRangeCommand}" />
                            </Border.GestureRecognizers>
                            <Label Text="Apply range"
                                   FontFamily="OpenSansBold"
                                   FontSize="12"
                                   FontAttributes="Bold"
                                   TextColor="{StaticResource White}"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center" />
                        </Border>
                    </VerticalStackLayout>
                </Border>

                <!-- Summary hero card -->
                <Border BackgroundColor="{StaticResource Ink2}"
                        Margin="14,10,14,0"
                        StrokeShape="RoundRectangle 16"
                        Stroke="Transparent"
                        Padding="16">
                    <VerticalStackLayout Spacing="0">
                        <Label Text="{Binding HeroPeriodLabel}"
                               FontFamily="OpenSansBold"
                               FontSize="10"
                               FontAttributes="Bold"
                               TextColor="{StaticResource InkMuted}"
                               CharacterSpacing="0.5" />
                        <Label Text="{Binding TotalFormatted}"
                               FontFamily="OpenSansBold"
                               FontSize="26"
                               FontAttributes="Bold"
                               TextColor="{StaticResource White}"
                               Margin="0,4,0,2" />
                        <Label Text="{Binding SummaryMeta}"
                               FontFamily="OpenSansRegular"
                               FontSize="10"
                               TextColor="{StaticResource InkMuted}" />

                        <Border Margin="0,12,0,0"
                                StrokeShape="RoundRectangle 4"
                                Stroke="Transparent"
                                HeightRequest="8"
                                HorizontalOptions="Fill"
                                BackgroundColor="{StaticResource Ink3}"
                                IsVisible="{Binding HasData}">
                            <FlexLayout Direction="Row"
                                        AlignItems="Stretch"
                                        HeightRequest="8"
                                        BindableLayout.ItemsSource="{Binding StackedBarSegments}">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate x:DataType="models:StackedBarSegment">
                                        <BoxView Color="{Binding Color}"
                                                 HeightRequest="8"
                                                 FlexLayout.Grow="{Binding Share}" />
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </FlexLayout>
                        </Border>

                        <Label Text="{Binding TopCategoryInsight}"
                               FontFamily="OpenSansRegular"
                               FontSize="10"
                               TextColor="{StaticResource InkSubtle}"
                               Margin="0,10,0,0"
                               LineBreakMode="WordWrap"
                               IsVisible="{Binding HasData}" />

                        <FlexLayout Margin="0,8,0,0"
                                    Wrap="Wrap"
                                    Direction="Row"
                                    AlignItems="Center"
                                    IsVisible="{Binding HasData}"
                                    BindableLayout.ItemsSource="{Binding LegendItems}">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="models:ReportLegendItem">
                                    <HorizontalStackLayout Spacing="4"
                                                           Margin="0,0,10,4">
                                        <BoxView WidthRequest="8"
                                                 HeightRequest="8"
                                                 CornerRadius="2"
                                                 Color="{Binding Color}"
                                                 VerticalOptions="Center" />
                                        <Label Text="{Binding Label}"
                                               FontFamily="OpenSansRegular"
                                               FontSize="9"
                                               TextColor="{StaticResource InkMuted}"
                                               VerticalOptions="Center" />
                                    </HorizontalStackLayout>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </FlexLayout>
                    </VerticalStackLayout>
                </Border>

                <!-- By category -->
                <Label Text="By category"
                       Style="{StaticResource SectionLabel}" />

                <Border Style="{StaticResource CardBorder}"
                        Margin="14,0,14,0"
                        Padding="14,12">
                    <VerticalStackLayout Spacing="10"
                                         BindableLayout.ItemsSource="{Binding Categories}">
                        <BindableLayout.EmptyView>
                            <Label Text="No spending data for this period."
                                   FontFamily="OpenSansRegular"
                                   FontSize="12"
                                   TextColor="{DynamicResource T2}" />
                        </BindableLayout.EmptyView>
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="models:CategoryBreakdownItem">
                                <VerticalStackLayout Spacing="4">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <HorizontalStackLayout Spacing="6" VerticalOptions="Center">
                                            <BoxView WidthRequest="8"
                                                     HeightRequest="8"
                                                     CornerRadius="2"
                                                     Color="{Binding BarColor}"
                                                     VerticalOptions="Center" />
                                            <Label Text="{Binding Category}"
                                                   FontFamily="OpenSansBold"
                                                   FontSize="12"
                                                   FontAttributes="Bold"
                                                   TextColor="{DynamicResource T1}"
                                                   VerticalOptions="Center" />
                                        </HorizontalStackLayout>
                                        <Label Grid.Column="1"
                                               Text="{Binding AmountLabel}"
                                               FontFamily="OpenSansRegular"
                                               FontSize="10"
                                               TextColor="{DynamicResource T2}"
                                               VerticalOptions="Center"
                                               HorizontalTextAlignment="End" />
                                    </Grid>
                                    <Border HeightRequest="6"
                                            BackgroundColor="{DynamicResource Border2}"
                                            StrokeShape="RoundRectangle 3"
                                            Stroke="Transparent"
                                            Padding="0">
                                        <FlexLayout Direction="Row"
                                                    HeightRequest="6"
                                                    AlignItems="Stretch">
                                            <BoxView Color="{Binding BarColor}"
                                                     HeightRequest="6"
                                                     FlexLayout.Grow="{Binding Percent}" />
                                            <BoxView Color="Transparent"
                                                     HeightRequest="6"
                                                     FlexLayout.Grow="{Binding RemainingShare}" />
                                        </FlexLayout>
                                    </Border>
                                </VerticalStackLayout>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                </Border>

                <!-- Budget progress -->
                <Label Text="Budget progress"
                       Style="{StaticResource SectionLabel}"
                       IsVisible="{Binding HasBudgets}" />

                <Border Style="{StaticResource CardBorder}"
                        Margin="14,0,14,0"
                        Padding="14,12"
                        IsVisible="{Binding HasBudgets}">
                    <VerticalStackLayout Spacing="12"
                                         BindableLayout.ItemsSource="{Binding BudgetStatuses}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="models:CategoryBudgetStatus">
                                <VerticalStackLayout Spacing="4">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <Label Text="{Binding Category}"
                                               FontFamily="OpenSansBold"
                                               FontSize="12"
                                               FontAttributes="Bold"
                                               TextColor="{DynamicResource T1}"
                                               VerticalOptions="Center" />
                                        <Label Grid.Column="1"
                                               Text="{Binding StatusLabel}"
                                               FontFamily="OpenSansRegular"
                                               FontSize="10"
                                               TextColor="{DynamicResource T2}"
                                               VerticalOptions="Center" />
                                    </Grid>
                                    <Border HeightRequest="6"
                                            BackgroundColor="{DynamicResource Border2}"
                                            StrokeShape="RoundRectangle 3"
                                            Stroke="Transparent">
                                        <BoxView Color="{Binding BarColor}"
                                                 WidthRequest="{Binding BarFillWidth}"
                                                 HeightRequest="6"
                                                 HorizontalOptions="Start" />
                                    </Border>
                                    <Label Text="{Binding OverBudgetLabel}"
                                           FontFamily="OpenSansBold"
                                           FontSize="9"
                                           FontAttributes="Bold"
                                           TextColor="{StaticResource Red}"
                                           IsVisible="{Binding IsOverBudget}" />
                                </VerticalStackLayout>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                </Border>

                <!-- Export -->
                <Label Text="Export"
                       Style="{StaticResource SectionLabel}" />

                <VerticalStackLayout Margin="14,0,14,12"
                                     Spacing="8">

                    <!-- CSV -->
                    <Border Style="{StaticResource CardBorder}"
                            Padding="0">
                        <Grid Padding="14,13"
                              ColumnDefinitions="Auto,*,Auto">
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding PreviewCsvCommand}" />
                            </Grid.GestureRecognizers>
                            <Border WidthRequest="40"
                                    HeightRequest="40"
                                    BackgroundColor="#ECFDF5"
                                    Stroke="#A7F3D0"
                                    StrokeThickness="0.5"
                                    StrokeShape="RoundRectangle 11"
                                    VerticalOptions="Center">
                                <Image Source="icon_export_table.svg"
                                       WidthRequest="18"
                                       HeightRequest="18"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center" />
                            </Border>
                            <VerticalStackLayout Grid.Column="1"
                                                 Margin="12,0,8,0"
                                                 Spacing="2"
                                                 VerticalOptions="Center">
                                <Label Text="CSV Spreadsheet"
                                       FontFamily="OpenSansBold"
                                       FontSize="13"
                                       FontAttributes="Bold"
                                       TextColor="{DynamicResource T1}" />
                                <Label Text="Preview in app, then share to Sheets"
                                       FontFamily="OpenSansRegular"
                                       FontSize="11"
                                       TextColor="{DynamicResource T2}" />
                            </VerticalStackLayout>
                            <ActivityIndicator Grid.Column="2"
                                               Color="{StaticResource Violet}"
                                               WidthRequest="18"
                                               HeightRequest="18"
                                               IsRunning="{Binding IsExporting}"
                                               IsVisible="{Binding IsExporting}"
                                               VerticalOptions="Center" />
                            <Image Grid.Column="2"
                                   Source="icon_ui_chevron.svg"
                                   WidthRequest="16"
                                   HeightRequest="16"
                                   VerticalOptions="Center"
                                   IsVisible="{Binding IsExporting, Converter={StaticResource InvertedBoolConverter}}" />
                        </Grid>
                    </Border>

                    <!-- PDF -->
                    <Border Style="{StaticResource CardBorder}"
                            Padding="0">
                        <Grid Padding="14,13"
                              ColumnDefinitions="Auto,*,Auto">
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding ExportPdfCommand}" />
                            </Grid.GestureRecognizers>
                            <Border WidthRequest="40"
                                    HeightRequest="40"
                                    BackgroundColor="{DynamicResource VioletTint}"
                                    Stroke="{DynamicResource VioletMid}"
                                    StrokeThickness="0.5"
                                    StrokeShape="RoundRectangle 11"
                                    VerticalOptions="Center">
                                <Image Source="icon_export_pdf.svg"
                                       WidthRequest="18"
                                       HeightRequest="18"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center" />
                            </Border>
                            <VerticalStackLayout Grid.Column="1"
                                                 Margin="12,0,8,0"
                                                 Spacing="2"
                                                 VerticalOptions="Center">
                                <Label Text="PDF Report"
                                       FontFamily="OpenSansBold"
                                       FontSize="13"
                                       FontAttributes="Bold"
                                       TextColor="{DynamicResource T1}" />
                                <Label Text="Tax &amp; reimbursement"
                                       FontFamily="OpenSansRegular"
                                       FontSize="11"
                                       TextColor="{DynamicResource T2}" />
                            </VerticalStackLayout>
                            <ActivityIndicator Grid.Column="2"
                                               Color="{StaticResource Violet}"
                                               WidthRequest="18"
                                               HeightRequest="18"
                                               IsRunning="{Binding IsExporting}"
                                               IsVisible="{Binding IsExporting}"
                                               VerticalOptions="Center" />
                            <Image Grid.Column="2"
                                   Source="icon_ui_chevron.svg"
                                   WidthRequest="16"
                                   HeightRequest="16"
                                   VerticalOptions="Center"
                                   IsVisible="{Binding IsExporting, Converter={StaticResource InvertedBoolConverter}}" />
                        </Grid>
                    </Border>

                    <!-- Email -->
                    <Border Style="{StaticResource CardBorder}"
                            Padding="0">
                        <Grid Padding="14,13"
                              ColumnDefinitions="Auto,*,Auto">
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding EmailReportCommand}" />
                            </Grid.GestureRecognizers>
                            <Border WidthRequest="40"
                                    HeightRequest="40"
                                    BackgroundColor="#EFF6FF"
                                    Stroke="#BFDBFE"
                                    StrokeThickness="0.5"
                                    StrokeShape="RoundRectangle 11"
                                    VerticalOptions="Center">
                                <Image Source="icon_export_mail.svg"
                                       WidthRequest="18"
                                       HeightRequest="18"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center" />
                            </Border>
                            <VerticalStackLayout Grid.Column="1"
                                                 Margin="12,0,8,0"
                                                 Spacing="2"
                                                 VerticalOptions="Center">
                                <Label Text="Email report"
                                       FontFamily="OpenSansBold"
                                       FontSize="13"
                                       FontAttributes="Bold"
                                       TextColor="{DynamicResource T1}" />
                                <Label Text="Preview message with PDF attachment"
                                       FontFamily="OpenSansRegular"
                                       FontSize="11"
                                       TextColor="{DynamicResource T2}"
                                       LineBreakMode="TailTruncation" />
                            </VerticalStackLayout>
                            <Image Grid.Column="2"
                                   Source="icon_ui_chevron.svg"
                                   WidthRequest="16"
                                   HeightRequest="16"
                                   VerticalOptions="Center" />
                        </Grid>
                    </Border>

                </VerticalStackLayout>
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
