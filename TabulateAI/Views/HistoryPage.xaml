<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:TabulateAI.ViewModels"
             xmlns:models="clr-namespace:TabulateAI.Models"
             xmlns:helpers="clr-namespace:TabulateAI.Helpers"
             x:Class="TabulateAI.Views.HistoryPage"
             x:Name="RootPage"
             x:DataType="vm:HistoryViewModel"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{DynamicResource Surface}">

    <Grid RowDefinitions="Auto,*">

        <!-- Row 0: Header -->
        <Grid Grid.Row="0"
              BackgroundColor="{DynamicResource CardWhite}"
              Padding="16,14,16,12"
              ColumnDefinitions="*,Auto"
              RowDefinitions="Auto,Auto">
            <VerticalStackLayout Grid.Column="0"
                                 Grid.Row="0"
                                 Spacing="0"
                                 VerticalOptions="Center">
                <Label Text="All receipts"
                       FontFamily="OpenSansBold"
                       FontSize="17"
                       FontAttributes="Bold"
                       TextColor="{DynamicResource T1}" />
                <Label Text="{Binding Subtitle}"
                       FontFamily="OpenSansRegular"
                       FontSize="11"
                       TextColor="{DynamicResource T2}"
                       Margin="0,2,0,0" />
            </VerticalStackLayout>
            <Image Grid.Column="1"
                   Grid.Row="0"
                   Source="icon_ui_filter.svg"
                   WidthRequest="20"
                   HeightRequest="20"
                   VerticalOptions="Center" />
            <BoxView Grid.Row="1"
                     Grid.ColumnSpan="2"
                     HeightRequest="0.5"
                     Color="{DynamicResource Border}"
                     Margin="0,12,0,0" />
        </Grid>

        <!-- Row 1: Content -->
        <Grid Grid.Row="1"
              RowDefinitions="Auto,Auto,*">

            <!-- Search bar -->
            <Border Grid.Row="0"
                    BackgroundColor="{DynamicResource CardWhite}"
                    Margin="14,10,14,6"
                    StrokeShape="RoundRectangle 12"
                    Stroke="{DynamicResource Border}"
                    StrokeThickness="0.5"
                    Padding="12,9">
                <HorizontalStackLayout Spacing="8"
                                       VerticalOptions="Center">
                    <Image Source="icon_ui_search.svg"
                           WidthRequest="16"
                           HeightRequest="16"
                           VerticalOptions="Center" />
                    <Entry Text="{Binding SearchQuery}"
                           Placeholder="Search store, amount, date..."
                           PlaceholderColor="{DynamicResource T3}"
                           FontFamily="OpenSansRegular"
                           FontSize="12"
                           TextColor="{DynamicResource T1}"
                           BackgroundColor="Transparent"
                           HorizontalOptions="FillAndExpand"
                           VerticalOptions="Center" />
                </HorizontalStackLayout>
            </Border>

            <!-- Filter chips -->
            <ScrollView Grid.Row="1"
                        Orientation="Horizontal"
                        HorizontalScrollBarVisibility="Never"
                        Padding="14,0,14,8">
                <HorizontalStackLayout BindableLayout.ItemsSource="{Binding FilterOptions}"
                                       Spacing="6">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="models:CategoryOption">
                            <Border StrokeShape="RoundRectangle 20"
                                    Stroke="{DynamicResource Border}"
                                    StrokeThickness="0.5"
                                    Padding="13,6"
                                    BackgroundColor="{DynamicResource CardWhite}">
                                <Border.Triggers>
                                    <DataTrigger TargetType="Border"
                                                 Binding="{Binding IsSelected}"
                                                 Value="True">
                                        <Setter Property="BackgroundColor" Value="{StaticResource Violet}" />
                                        <Setter Property="Stroke" Value="Transparent" />
                                        <Setter Property="StrokeThickness" Value="0" />
                                    </DataTrigger>
                                </Border.Triggers>
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnFilterTapped" />
                                </Border.GestureRecognizers>
                                <Label Text="{Binding Name}"
                                       FontFamily="OpenSansBold"
                                       FontSize="10"
                                       FontAttributes="Bold"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center"
                                       TextColor="{DynamicResource T2}">
                                    <Label.Triggers>
                                        <DataTrigger TargetType="Label"
                                                     Binding="{Binding IsSelected}"
                                                     Value="True">
                                            <Setter Property="TextColor" Value="{StaticResource White}" />
                                        </DataTrigger>
                                    </Label.Triggers>
                                </Label>
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </HorizontalStackLayout>
            </ScrollView>

            <!-- Empty state -->
            <VerticalStackLayout Grid.Row="2"
                                 IsVisible="{Binding ShowEmptyState}"
                                 VerticalOptions="Center"
                                 HorizontalOptions="Center"
                                 Padding="32">
                <Border WidthRequest="56"
                        HeightRequest="56"
                        BackgroundColor="{DynamicResource VioletTint}"
                        Stroke="{DynamicResource VioletMid}"
                        StrokeThickness="0.5"
                        StrokeShape="RoundRectangle 16"
                        HorizontalOptions="Center">
                    <Image Source="icon_cat_receipt.svg"
                           WidthRequest="28"
                           HeightRequest="28"
                           HorizontalOptions="Center"
                           VerticalOptions="Center" />
                </Border>
                <Label Text="No receipts yet"
                       FontFamily="OpenSansBold"
                       FontSize="17"
                       FontAttributes="Bold"
                       TextColor="{DynamicResource T1}"
                       HorizontalOptions="Center"
                       Margin="0,16,0,0" />
                <Label Text="Scan a receipt to build your history."
                       FontFamily="OpenSansRegular"
                       FontSize="13"
                       TextColor="{DynamicResource T2}"
                       HorizontalTextAlignment="Center"
                       Margin="0,8,0,0" />
                <Border BackgroundColor="{StaticResource Violet}"
                        StrokeShape="RoundRectangle 13"
                        Stroke="Transparent"
                        HeightRequest="52"
                        WidthRequest="220"
                        Margin="0,20,0,0">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding ScanNowCommand}" />
                    </Border.GestureRecognizers>
                    <HorizontalStackLayout Spacing="8"
                                           HorizontalOptions="Center"
                                           VerticalOptions="Center">
                        <Image Source="icon_feature_scan.svg"
                               WidthRequest="18"
                               HeightRequest="18"
                               VerticalOptions="Center" />
                        <Label Text="Scan new receipt"
                               FontFamily="OpenSansBold"
                               FontSize="14"
                               FontAttributes="Bold"
                               TextColor="{StaticResource White}"
                               VerticalOptions="Center" />
                    </HorizontalStackLayout>
                </Border>
            </VerticalStackLayout>

            <!-- Receipt list -->
            <RefreshView Grid.Row="2"
                         IsRefreshing="{Binding IsRefreshing}"
                         Command="{Binding RefreshCommand}"
                         IsVisible="{Binding ShowEmptyState, Converter={StaticResource InvertedBoolConverter}}">
                <CollectionView ItemsSource="{Binding GroupedReceipts}"
                                IsGrouped="True"
                                SelectionMode="Single"
                                SelectedItem="{Binding SelectedReceipt}">
                    <CollectionView.GroupHeaderTemplate>
                        <DataTemplate x:DataType="models:ReceiptGroup">
                            <Label Text="{Binding GroupName}"
                                   Style="{StaticResource SectionLabel}"
                                   Margin="14,14,14,6" />
                        </DataTemplate>
                    </CollectionView.GroupHeaderTemplate>
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="models:ReceiptDisplayItem">
                            <VerticalStackLayout Margin="14,0,14,0">
                                <VerticalStackLayout.Triggers>
                                    <DataTrigger TargetType="VerticalStackLayout"
                                                 Binding="{Binding IsLastInGroup}"
                                                 Value="True">
                                        <Setter Property="Margin" Value="14,0,14,10" />
                                    </DataTrigger>
                                </VerticalStackLayout.Triggers>
                                <Border BackgroundColor="{DynamicResource CardWhite}"
                                        Stroke="{DynamicResource Border}"
                                        StrokeThickness="0.5"
                                        Padding="0">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="{Binding ItemCornerRadius}" />
                                    </Border.StrokeShape>
                                    <VerticalStackLayout Spacing="0">
                                        <Grid Padding="14,11"
                                              ColumnDefinitions="Auto,*,Auto">
                                            <Border WidthRequest="38"
                                                    HeightRequest="38"
                                                    BackgroundColor="{Binding IconBackground}"
                                                    StrokeShape="RoundRectangle 10"
                                                    Stroke="Transparent"
                                                    VerticalOptions="Center">
                                                <Border.Triggers>
                                                    <DataTrigger TargetType="Border"
                                                                 Binding="{Binding HasMerchantLogo}"
                                                                 Value="True">
                                                        <Setter Property="Stroke" Value="{DynamicResource Border}" />
                                                        <Setter Property="StrokeThickness" Value="0.5" />
                                                    </DataTrigger>
                                                </Border.Triggers>
                                                <Image Source="{Binding IconSource}"
                                                       WidthRequest="18"
                                                       HeightRequest="18"
                                                       HorizontalOptions="Center"
                                                       VerticalOptions="Center">
                                                    <Image.Triggers>
                                                        <DataTrigger TargetType="Image"
                                                                     Binding="{Binding HasMerchantLogo}"
                                                                     Value="True">
                                                            <Setter Property="WidthRequest" Value="28" />
                                                            <Setter Property="HeightRequest" Value="28" />
                                                            <Setter Property="Aspect" Value="AspectFit" />
                                                        </DataTrigger>
                                                    </Image.Triggers>
                                                </Image>
                                            </Border>
                                            <VerticalStackLayout Grid.Column="1"
                                                                 Margin="10,0,8,0"
                                                                 Spacing="1"
                                                                 VerticalOptions="Center">
                                                <Label Text="{Binding Name}"
                                                       FontFamily="OpenSansBold"
                                                       FontSize="13"
                                                       FontAttributes="Bold"
                                                       TextColor="{DynamicResource T1}"
                                                       LineBreakMode="TailTruncation" />
                                                <Label Text="{Binding Meta}"
                                                       FontFamily="OpenSansRegular"
                                                       FontSize="10"
                                                       TextColor="{DynamicResource T2}" />
                                            </VerticalStackLayout>
                                            <Label Grid.Column="2"
                                                   Text="{Binding AmountFormatted}"
                                                   FontFamily="OpenSansBold"
                                                   FontSize="14"
                                                   FontAttributes="Bold"
                                                   TextColor="{DynamicResource T1}"
                                                   VerticalOptions="Center" />
                                        </Grid>
                                        <BoxView HeightRequest="0.5"
                                                 Color="{DynamicResource Border2}"
                                                 Margin="14,0"
                                                 IsVisible="{Binding ShowDivider}" />
                                    </VerticalStackLayout>
                                </Border>
                            </VerticalStackLayout>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </RefreshView>
        </Grid>
    </Grid>
</ContentPage>
