<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:TabulateAI.ViewModels"
             x:Class="TabulateAI.Views.ProcessingPage"
             x:DataType="vm:ProcessingViewModel"
             Shell.NavBarIsVisible="False"
             Shell.TabBarIsVisible="False"
             BackgroundColor="{StaticResource Surface}">

    <Grid RowDefinitions="Auto,*">

        <!-- Row 0: Header -->
        <Grid Grid.Row="0"
              BackgroundColor="{StaticResource CardWhite}"
              Padding="16,14,16,12"
              RowDefinitions="Auto,Auto">
            <VerticalStackLayout Grid.Row="0"
                                 Spacing="0"
                                 HorizontalOptions="Center">
                <Label Text="Processing"
                       FontFamily="OpenSansBold"
                       FontSize="17"
                       FontAttributes="Bold"
                       TextColor="{StaticResource T1}"
                       HorizontalTextAlignment="Center" />
                <Label Text="Extracting your receipt data"
                       FontFamily="OpenSansRegular"
                       FontSize="11"
                       TextColor="{StaticResource T2}"
                       Margin="0,2,0,0"
                       HorizontalTextAlignment="Center" />
            </VerticalStackLayout>
            <BoxView Grid.Row="1"
                     HeightRequest="0.5"
                     Color="{StaticResource Border}"
                     Margin="0,12,0,0" />
        </Grid>

        <!-- Row 1: Central content -->
        <Grid Grid.Row="1"
              Padding="24"
              HorizontalOptions="Fill"
              VerticalOptions="Fill">

            <ScrollView HorizontalOptions="Fill"
                        VerticalOptions="Fill"
                        HorizontalScrollBarVisibility="Never"
                        VerticalScrollBarVisibility="Never">
                <Grid MinimumHeightRequest="520"
                      HorizontalOptions="Fill"
                      VerticalOptions="Fill">
                    <VerticalStackLayout HorizontalOptions="Center"
                                         VerticalOptions="Center"
                                         Spacing="16"
                                         WidthRequest="320"
                                         MaximumWidthRequest="360">

                <!-- Pulsing receipt card -->
                <Border x:Name="ReceiptCard"
                        WidthRequest="128"
                        HeightRequest="162"
                        HorizontalOptions="Center"
                        BackgroundColor="{StaticResource CardWhite}"
                        StrokeShape="RoundRectangle 12"
                        Stroke="{StaticResource Border}"
                        StrokeThickness="0.5"
                        Padding="10">
                    <Grid RowDefinitions="Auto,*,Auto">
                        <VerticalStackLayout Grid.Row="0"
                                             Spacing="4">
                            <HorizontalStackLayout Spacing="6"
                                                   Margin="0,0,0,4">
                                <BoxView WidthRequest="14"
                                         HeightRequest="14"
                                         CornerRadius="7"
                                         Color="{StaticResource Violet}"
                                         VerticalOptions="Center" />
                                <Label Text="READING"
                                       FontFamily="OpenSansBold"
                                       FontSize="8"
                                       FontAttributes="Bold"
                                       TextColor="{StaticResource Violet}"
                                       VerticalOptions="Center" />
                            </HorizontalStackLayout>
                            <BoxView HeightRequest="6"
                                     WidthRequest="102"
                                     CornerRadius="3"
                                     Color="{StaticResource VioletMid}"
                                     HorizontalOptions="Start" />
                            <BoxView HeightRequest="6"
                                     WidthRequest="77"
                                     CornerRadius="3"
                                     Color="{StaticResource Border2}"
                                     Margin="0,2,0,0"
                                     HorizontalOptions="Start" />
                            <BoxView HeightRequest="6"
                                     WidthRequest="115"
                                     CornerRadius="3"
                                     Color="{StaticResource VioletMid}"
                                     Margin="0,2,0,0"
                                     HorizontalOptions="Start" />
                            <BoxView HeightRequest="6"
                                     WidthRequest="64"
                                     CornerRadius="3"
                                     Color="{StaticResource Border2}"
                                     Margin="0,6,0,0"
                                     HorizontalOptions="Start" />
                            <BoxView HeightRequest="6"
                                     WidthRequest="96"
                                     CornerRadius="3"
                                     Color="{StaticResource Border2}"
                                     Margin="0,2,0,0"
                                     HorizontalOptions="Start" />
                            <BoxView HeightRequest="6"
                                     WidthRequest="83"
                                     CornerRadius="3"
                                     Color="{StaticResource Border2}"
                                     Margin="0,2,0,0"
                                     HorizontalOptions="Start" />
                        </VerticalStackLayout>

                        <Grid Grid.Row="2"
                              RowDefinitions="Auto,Auto"
                              Margin="0,6,0,0">
                            <BoxView Grid.Row="0"
                                     HeightRequest="0.5"
                                     Color="{StaticResource Border}" />
                            <Grid Grid.Row="1"
                                  ColumnDefinitions="*,Auto"
                                  Padding="0,6,0,0">
                                <Label Text="TOTAL"
                                       FontFamily="OpenSansRegular"
                                       FontSize="7"
                                       TextColor="{StaticResource T3}"
                                       VerticalOptions="Center" />
                                <Label Grid.Column="1"
                                       Text="{Binding PreviewTotalFormatted}"
                                       FontFamily="OpenSansBold"
                                       FontSize="9"
                                       FontAttributes="Bold"
                                       TextColor="{StaticResource Violet}"
                                       VerticalOptions="Center" />
                            </Grid>
                        </Grid>
                    </Grid>
                </Border>

                <!-- Progress bar -->
                <ProgressBar x:Name="ProcessingProgressBar"
                             WidthRequest="160"
                             HeightRequest="4"
                             Progress="0"
                             ProgressColor="{StaticResource Violet}"
                             BackgroundColor="{StaticResource Border}"
                             HorizontalOptions="Center" />

                <!-- Status -->
                <Label Text="{Binding StatusText}"
                       FontFamily="OpenSansBold"
                       FontSize="13"
                       FontAttributes="Bold"
                       TextColor="{StaticResource T1}"
                       HorizontalOptions="Center"
                       HorizontalTextAlignment="Center" />

                <Label Text="Reading store name, items, totals, date &amp; payment method"
                       FontFamily="OpenSansRegular"
                       FontSize="10"
                       TextColor="{StaticResource T2}"
                       HorizontalOptions="Center"
                       HorizontalTextAlignment="Center"
                       LineHeight="1.5"
                       MaximumWidthRequest="320" />

                <!-- Step list -->
                <VerticalStackLayout Spacing="6"
                                     WidthRequest="320"
                                     MaximumWidthRequest="360"
                                     HorizontalOptions="Center"
                                     Margin="0,4,0,0">

                    <Border BackgroundColor="{StaticResource CardWhite}"
                            StrokeShape="RoundRectangle 10"
                            Stroke="{StaticResource Border}"
                            StrokeThickness="0.5"
                            Padding="12,9"
                            IsVisible="{Binding Step1Done}">
                        <HorizontalStackLayout Spacing="8"
                                               VerticalOptions="Center">
                            <Image Source="icon_ui_check_violet.svg"
                                   WidthRequest="14"
                                   HeightRequest="14"
                                   VerticalOptions="Center" />
                            <Label Text="Store name extracted"
                                   FontFamily="OpenSansRegular"
                                   FontSize="12"
                                   TextColor="{StaticResource T1}"
                                   VerticalOptions="Center" />
                        </HorizontalStackLayout>
                    </Border>

                    <Border BackgroundColor="{StaticResource CardWhite}"
                            StrokeShape="RoundRectangle 10"
                            Stroke="{StaticResource Border}"
                            StrokeThickness="0.5"
                            Padding="12,9"
                            IsVisible="{Binding Step2Done}">
                        <HorizontalStackLayout Spacing="8"
                                               VerticalOptions="Center">
                            <Image Source="icon_ui_check_violet.svg"
                                   WidthRequest="14"
                                   HeightRequest="14"
                                   VerticalOptions="Center" />
                            <Label Text="Date &amp; time found"
                                   FontFamily="OpenSansRegular"
                                   FontSize="12"
                                   TextColor="{StaticResource T1}"
                                   VerticalOptions="Center" />
                        </HorizontalStackLayout>
                    </Border>

                    <Border BackgroundColor="{StaticResource CardWhite}"
                            StrokeShape="RoundRectangle 10"
                            Stroke="{StaticResource Border}"
                            StrokeThickness="0.5"
                            Padding="12,9"
                            Opacity="{Binding Step3Opacity}">
                        <HorizontalStackLayout Spacing="8"
                                               VerticalOptions="Center">
                            <Image Source="icon_ui_check_violet.svg"
                                   WidthRequest="14"
                                   HeightRequest="14"
                                   VerticalOptions="Center"
                                   IsVisible="{Binding Step3InProgress, Converter={StaticResource InvertedBoolConverter}}" />
                            <ActivityIndicator Color="{StaticResource Violet}"
                                               WidthRequest="14"
                                               HeightRequest="14"
                                               IsRunning="{Binding Step3InProgress}"
                                               IsVisible="{Binding Step3InProgress}"
                                               VerticalOptions="Center" />
                            <Label FontFamily="OpenSansRegular"
                                   FontSize="12"
                                   VerticalOptions="Center">
                                <Label.Triggers>
                                    <DataTrigger TargetType="Label"
                                                 Binding="{Binding Step3InProgress}"
                                                 Value="True">
                                        <Setter Property="Text" Value="Reading line items..." />
                                        <Setter Property="TextColor" Value="{StaticResource T2}" />
                                    </DataTrigger>
                                    <DataTrigger TargetType="Label"
                                                 Binding="{Binding Step3InProgress}"
                                                 Value="False">
                                        <Setter Property="Text" Value="Line items extracted" />
                                        <Setter Property="TextColor" Value="{StaticResource T1}" />
                                    </DataTrigger>
                                </Label.Triggers>
                            </Label>
                        </HorizontalStackLayout>
                    </Border>
                </VerticalStackLayout>

                <Button Text="View extracted data"
                        Command="{Binding ViewResultsCommand}"
                        Style="{StaticResource PrimaryBtn}"
                        Padding="12,0"
                        Margin="0,4,0,20"
                        HorizontalOptions="Fill"
                        IsVisible="{Binding IsComplete}" />
                    </VerticalStackLayout>
                </Grid>
            </ScrollView>
        </Grid>
    </Grid>
</ContentPage>
