<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="SpendSmart.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:SpendSmart.Views"
    Title="SpendSmart"
    Shell.FlyoutBehavior="Disabled">

    <TabBar>
        <ShellContent
            Title="Scan"
            ContentTemplate="{DataTemplate views:ScanPage}"
            Route="ScanPage" />

        <ShellContent
            Title="Archive"
            ContentTemplate="{DataTemplate views:ArchivePage}"
            Route="ArchivePage" />

        <ShellContent
            Title="Dashboard"
            ContentTemplate="{DataTemplate views:DashboardPage}"
            Route="DashboardPage" />
    </TabBar>

</Shell>
