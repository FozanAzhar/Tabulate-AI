<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:SpendSmart.ViewModels"
             x:Class="SpendSmart.Views.ScanPage"
             x:DataType="vm:ScanViewModel"
             Title="Scan">

    <ScrollView>
        <VerticalStackLayout Padding="24" Spacing="20">
            <Label Text="SpendSmart"
                   Style="{StaticResource Headline}"
                   HorizontalOptions="Center" />
            <Label Text="Less clutter, More clarity."
                   Style="{StaticResource SubHeadline}"
                   HorizontalOptions="Center"
                   HorizontalTextAlignment="Center" />

            <Border Stroke="{StaticResource Gray200}"
                    StrokeThickness="1"
                    BackgroundColor="{StaticResource Secondary}"
                    Padding="20"
                    StrokeShape="RoundRectangle 16">
                <VerticalStackLayout Spacing="12">
                    <Label Text="{Binding StatusMessage}"
                           HorizontalTextAlignment="Center" />
                    <ActivityIndicator IsRunning="{Binding IsBusy}"
                                       IsVisible="{Binding IsBusy}"
                                       HorizontalOptions="Center"
                                       Color="{StaticResource Primary}" />
                </VerticalStackLayout>
            </Border>

            <Button Text="Capture Receipt"
                    Command="{Binding CapturePhotoCommand}"
                    IsEnabled="{Binding IsBusy, Converter={StaticResource InvertedBoolConverter}}" />

            <Button Text="Pick from Gallery"
                    Command="{Binding PickPhotoCommand}"
                    Style="{StaticResource SecondaryButton}"
                    IsEnabled="{Binding IsBusy, Converter={StaticResource InvertedBoolConverter}}" />

            <Button Text="Manual Entry"
                    Command="{Binding ManualEntryCommand}"
                    Style="{StaticResource SecondaryButton}"
                    IsEnabled="{Binding IsBusy, Converter={StaticResource InvertedBoolConverter}}" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
